MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mydb      # Doit correspondre à la variable attendue par MySQL
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword
MYSQL_EXTERNAL_PORT=3307          # Make sure to stop the MySql service on your device if you want to use 3307, else change this port. If changed: watch out for firewall rules! linux: sudo ufw allow 3307/tcp
MYSQL_INTERNAL_PORT=3306          # needed to set this. IMPORTANT to keep it to 3306, otherwise the db mysql image will not work in the docker network
MYSQL_HOST=db             # Nom du service Docker (db dans docker-compose.yml)
DJANGO_URL=http://django:8080/api/tutorials
DJANGO_PORT=8080
EXTERNAL_PORT_PLANE_API=3000
EXTERNAL_PORT_SHIP_API=4000
EXTERNAL_PORT_INCIDENT_GENERATOR_API=3001
INTERNAL_PORT_API=80
FRONTEND_PORT=8000

KEY_FLIGHT_API = PASSWORD FOR OPENSKY API https://openskynetwork.github.io/opensky-api/
USER_FLIGHT_API = OPENSKY USERNAME
KEY_SHIP_API = API KEY FOR https://aisstream.io/
SHIP_ENTRY = 0
FLIGHT_ENTRY = 0
